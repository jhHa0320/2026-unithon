# ── LLM ──────────────────────────────────────────────────────────────
# 키가 설정된 프로바이더가 자동 선택된다: Gemini > Claude > Mock
# 둘 다 비어 있으면 MockAIClient로 떠서 Android 개발은 그대로 진행 가능하다.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# 지연이 중요하면 0으로 두어 thinking을 끈다. 비워두면 SDK 기본값.
GEMINI_THINKING_BUDGET=

# 대안 프로바이더
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

AI_CLIENT_TIMEOUT_SECONDS=12.0

# ── 안전 게이트 ───────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.6

# ── 세션 ─────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=30

# 되돌릴 수 없는 행동 / 민감정보 패턴은 backend/config.py의 기본값을 쓰며,
# 덮어쓰려면 JSON 배열로 지정한다.
# IRREVERSIBLE_KEYWORDS=["결제","송금","전송","삭제"]
