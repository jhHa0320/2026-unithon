# 이 파일을 .env로 복사해서 값을 채우세요.  cp .env.example .env
# .env는 .gitignore에 있으므로 커밋되지 않습니다. 키를 이 파일에 직접 적지 마세요.

# --- Gemini ---
# https://aistudio.google.com/apikey 에서 발급
# 비워 두면 서버가 MockAIClient로 폴백합니다 (키 없이도 개발 가능).
GEMINI_API_KEY=

# gemini-1.5-*/2.0-*는 서비스 종료되어 사용할 수 없습니다.
# 2026-08-25 실측: 3.6-flash 2.2초 / 3.5-flash-lite 1.2초 (둘 다 정상)
#                  3.7-flash는 응답 없음(45초 타임아웃/504) — 최신이지만 쓰지 마세요.
# 더 빠르고 싼 대안: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# low | medium | high — 추론 깊이. 30초 KPI 때문에 기본 low.
# 화면 판단 정확도가 부족하면 medium으로 올리세요.
GEMINI_THINKING_LEVEL=low

# HTTP deadline(초). Gemini가 10초 미만을 400으로 거부하므로 10 아래로 내리지 마세요.
# 실측 응답은 2초대라 이 값은 예산이 아니라 안전망입니다.
GEMINI_TIMEOUT_SECONDS=10

# --- 안전 게이트 ---
# LLM confidence가 이 값 미만이면 서버가 ASK_USER로 강제 override
CONFIDENCE_THRESHOLD=0.6

# 세션 history 보관 시간(분)
SESSION_TTL_MINUTES=30

# 민감 요소 탐지 키워드. 결제를 '차단'하지 않고 로그 카운트에만 쓴다 (CLAUDE.md 4-1장).
SENSITIVE_KEYWORDS=["전송","보내기","송금","이체","결제","계좌","비밀번호","인증","삭제","탈퇴","주민번호","카드번호"]
