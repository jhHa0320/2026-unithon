<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 11+(API 30+) 패키지 가시성 제한 — targetSdk 37인 이 앱은 <queries>에 명시하지
      않으면 다른 앱을 "설치 안 됨"으로 취급한다(getLaunchIntentForPackage가 null 반환).
      카카오톡을 우리 앱이 직접 실행하려면 반드시 필요하다.
    -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <!-- 멤버 A(Infra/Voice/UX) 담당 권한. Accessibility 서비스 자체 선언은 멤버 C가 service/ 아래에 추가 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 화면 꺼짐 상태에서 깨워서 카카오톡을 실행하는 wakeup/ 흐름 전용 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pathpilot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported=true는 adb로 직접 테스트하기 위한 임시 설정. 팀 통합 시 false로 되돌릴 것 -->
        <activity
            android:name=".ui.permission.PermissionActivity"
            android:exported="true" />

        <!--
          멤버 A 개인 테스트용 서비스. 카카오톡 하나만 대상(res/xml/test_accessibility_service_config.xml).
          멤버 C가 정식 AccessibilityService를 만들면 이 <service> 블록과 관련 파일은 지운다.
        -->
        <service
            android:name=".testkit.TestAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/test_accessibility_service_config" />
        </service>

        <!--
          화면 꺼짐/잠금 상태에서 화면을 깨우고 카카오톡으로 이동하는 UI 없는 중계 Activity.
          showWhenLocked/turnScreenOn은 API 27+에서만 매니페스트 속성이 먹으므로, API 26 폴백은
          WakeAndLaunchActivity 코드 쪽 WindowManager 플래그로 처리한다.
        -->
        <activity
            android:name=".wakeup.WakeAndLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          테스트용 트리거 — exported=true는 adb로 직접 쏴보기 위한 설정이지만, 릴리스 빌드에서는
          WakeTriggerReceiver.onReceive()의 BuildConfig.DEBUG 체크로 스스로 무력화된다.
          진짜 트리거(웨이크워드 감지 등)가 생기면 이 리시버 자체를 삭제할 것.
        -->
        <receiver
            android:name=".wakeup.WakeTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.pathpilot.action.WAKE_AND_LAUNCH_KAKAO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>