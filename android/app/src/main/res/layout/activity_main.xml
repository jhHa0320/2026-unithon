<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 메인 화면 (screen/InApp Main Screen + InApp 마이크사용 감지 시안).

  한 레이아웃에 두 모드를 담고 MainActivity가 전환한다:
  - 대기 모드(group_idle): 손 흔드는 캐릭터 + "안녕, [손자] 라고 말해보세요!"
  - 듣는 중 모드(group_listening): 경청 캐릭터 + "듣고 있어요..." + 인식된 문장
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- 헤더: 사용자님/안녕하세요 + 프로필 원(권한 화면 진입) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_header_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_header_greeting"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/button_open_permissions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_circle_profile"
            android:contentDescription="@string/main_open_permissions"
            android:padding="12dp"
            android:src="@drawable/ic_person_orange" />
    </FrameLayout>

    <!-- 캐릭터: 뒤에 라디얼 글로우. 탭하면 웨이크 리스닝을 다시 시작한다. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_glow" />

        <ImageView
            android:id="@+id/image_character"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@string/main_restart_listening"
            android:scaleType="fitCenter"
            android:src="@drawable/char_greeting" />
    </FrameLayout>

    <!-- 대기 모드: “안녕, [손자] ” 라고 / 말해보세요! -->
    <LinearLayout
        android:id="@+id/group_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_headline_prefix"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- 웨이크 이름 칩. 탭하면 이름을 바꿀 수 있다. -->
            <TextView
                android:id="@+id/chip_wake_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_orange"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="손자" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_headline_suffix"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_headline_line2"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 듣는 중 모드 -->
    <LinearLayout
        android:id="@+id/group_listening"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_listening_title"
            android:textColor="@color/brand_orange_soft"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="start"
            android:textColor="@color/text_secondary"
            android:textSize="22sp"
            tools:text="안녕 손자\n카카오톡 열어주" />
    </LinearLayout>

    <!-- 상태 줄: 권한 경고·오류 등 부가 정보. 평소엔 비어 있다. -->
    <TextView
        android:id="@+id/text_wake_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- 하단 안내 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_cream"
        android:elevation="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic_dark" />

            <TextView
                android:id="@+id/text_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_card_idle_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_card_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_card_idle_caption"
            android:textColor="@color/brand_orange"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
