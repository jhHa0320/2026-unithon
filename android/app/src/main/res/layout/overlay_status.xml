<?xml version="1.0" encoding="utf-8"?>
<!--
  자동화 진행 오버레이 (screen/폰 메인 화면 ver1 시안).

  캐릭터가 카드 '위'(z축 앞)에 있고, 카드와 겹치지 않게 카드 바로 위에 선다.
  카드 하단 좌/우 모서리에 초록(중단하기=일시정지)·빨강(종료하기=X) 원형 버튼이 겹친다.
  뷰 순서 = 그리기 순서: 카드 -> 캐릭터 -> 버튼 (캐릭터가 카드보다 앞).
  하단바(뒤로가기 등)를 가리지 않는 오프셋은 StatusOverlayManager가 window y로 처리한다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 말풍선 카드: 캐릭터(높이 170dp)와 겹치지 않도록 그 아래에서 시작한다. -->
    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="174dp"
        android:background="@drawable/bg_card_cream"
        android:elevation="6dp"
        android:gravity="center"
        android:minHeight="170dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="52dp">

        <TextView
            android:id="@+id/overlay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/overlay_spinner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:indeterminateTint="@color/brand_orange"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 캐릭터: 카드보다 뒤에 선언돼도 z가 낮아지지 않도록 카드 다음에 두고 elevation을 더 높인다. -->
    <ImageView
        android:id="@+id/overlay_character"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@string/overlay_character_description"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/char_focused" />

    <!-- 중단하기: 초록 일시정지. 카드 좌하단 모서리에 걸친다. -->
    <ImageView
        android:id="@+id/overlay_btn_stop"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_circle_green"
        android:contentDescription="@string/overlay_stop_description"
        android:elevation="10dp"
        android:padding="15dp"
        android:src="@drawable/ic_pause_white" />

    <!-- 종료하기: 빨강 X. 카드 우하단 모서리에 걸친다. -->
    <ImageView
        android:id="@+id/overlay_btn_exit"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_circle_red"
        android:contentDescription="@string/overlay_exit_description"
        android:elevation="10dp"
        android:padding="15dp"
        android:src="@drawable/ic_close_white" />

</FrameLayout>
