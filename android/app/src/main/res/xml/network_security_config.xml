<?xml version="1.0" encoding="utf-8"?>
<!--
  개발용 백엔드가 아직 HTTPS가 아니라서(로컬 uvicorn) 평문 HTTP를 허용해야 한다.
  전체 허용이 아니라 개발 서버 주소만 예외로 둔다. 배포용 서버가 HTTPS로 확정되면
  이 파일과 AndroidManifest.xml의 android:networkSecurityConfig 참조를 지운다.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 에뮬레이터에서 호스트 PC -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 실기기 + adb reverse tcp:8000 tcp:8000 (USB 터널링) -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 실기기에서 같은 Wi-Fi의 개발 PC로 직접 붙을 때 (client isolation 없는 네트워크에서만 동작). IP가 바뀌면 같이 고칠 것 -->
        <domain includeSubdomains="false">10.28.85.74</domain>
    </domain-config>
</network-security-config>
