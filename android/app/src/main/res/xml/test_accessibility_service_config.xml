<?xml version="1.0" encoding="utf-8"?>
<!--
  멤버 A(나) 개인 테스트용 AccessibilityService 설정.
  지원 앱(카카오톡/카카오택시/코레일톡)만 대상으로 제한해서, 실수로 그 외 앱에 적용되지
  않도록 한다. 코레일톡은 실제 결제가 실행되는 앱이므로 테스트는 반드시 취소 가능한
  구간까지만 하거나 본인 계정으로 할 것. 여기 목록은 TestAccessibilityService.TARGET_PACKAGES와
  반드시 같이 맞춰야 한다 — 여기 없는 패키지는 코드에서 아무리 허용해도 이벤트 자체가 시스템
  레벨에서 걸러진다. 멤버 C가 정식 서비스를 만들면 이 파일과 TestAccessibilityService는
  지운다 — docs/ARCHITECTURE.md §2 참고.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="300"
    android:packageNames="com.kakao.talk,com.kakao.taxi,com.korail.talk"
    android:description="@string/test_accessibility_service_description" />
